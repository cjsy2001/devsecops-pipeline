{
  "permissions": {
    "allow": [
      "mcp__plugin_stf_stf",
      "Bash(make gitleaks)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "enabledPlugins": {
    "stf@secops-task-factory": true
  },
  "extraKnownMarketplaces": {
    "secops-task-factory": {
      "source": {
        "source": "github",
        "repo": "cjsy2001/secops-task-factory"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_stf_stf__stf_(advance_phase|reopen_phase|charter_spec|capture_.*|import_tasks|set_task_status|set_task_model|checkpoint|complete_run|handoff_emit|handoff_pickup|handoff_archive|verify)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/status-pages/hook.py\"",
            "timeout": 150,
            "statusMessage": "Refreshing status pages"
          }
        ]
      }
    ]
  }
}
